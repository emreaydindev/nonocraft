    "tutorial_2_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark squares you know are empty with a cross. Pick the cross tool to mark the gap."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesin boş olduğunu bildiğin kareleri çarpı ile işaretle. Boşluğu işaretlemek için çarpı aracını seç."
          }
        }
      }
    },

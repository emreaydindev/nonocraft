    "tutorial_1_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number on the left tells you how many squares to fill in that row. Drag to fill the first row."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldaki sayı o satırda kaç kareyi doldurman gerektiğini belirtir. İlk satırı doldurmak için sürükle."
          }
        }
      }
    },
